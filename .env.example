# MongoDB Connection String (Atlas URI or local MongoDB container)
# Format: mongodb://<host>:27017/<database> OR mongodb+srv://<user>:<password>@cluster.mongodb.net/<database>
MONGO_URI=mongodb+srv://24it002_db_user:<password>@cluster0.a0nmeid.mongodb.net/taskmanager?retryWrites=true&w=majority

# Backend Server Listening Port
PORT=5000

# JSON Web Token (JWT) Secret Key for Authentication
JWT_SECRET=supersecretjwtkey123

# Google Gemini API Key for AI Task Description Generator (gemini-2.5-flash)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

